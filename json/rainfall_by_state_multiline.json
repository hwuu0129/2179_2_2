{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Annual Rainfall by Australian State/Territory (2014–2024)",
    "subtitle": "Area-averaged rainfall (mm) with Black Summer reference"
  },
  "width": 600,
  "height": 400,
  "layer": [
    {
      "data": {
        "url": "https://hwuu0129.github.io/2179_2_2/data/aus_rainfall_state_2014_2024.csv"
      },
      "mark": {"type": "line", "point": true, "strokeWidth": 2},
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "axis": {"format": "d", "tickMinStep": 1}
        },
        "y": {
          "field": "rainfall_mm",
          "type": "quantitative",
          "title": "Rainfall (mm)"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "title": "State / Territory"
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "year", "title": "Year", "format": "d"},
          {"field": "rainfall_mm", "title": "Rainfall (mm)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"values": [{"year": 2019}]},
      "mark": {
        "type": "rule",
        "color": "red",
        "strokeDash": [6, 6],
        "strokeWidth": 2
      },
      "encoding": {"x": {"field": "year", "type": "quantitative"}}
    },
    {
      "data": {"values": [{"year": 2019, "label": "Black Summer"}]},
      "mark": {
        "type": "text",
        "color": "red",
        "fontWeight": "bold",
        "align": "left",
        "dx": 6,
        "dy": -8
      },
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"value": 18},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "axis": {"labelFontSize": 11, "titleFontSize": 12},
    "legend": {"labelFontSize": 11, "titleFontSize": 12},
    "title": {"fontSize": 16, "subtitleFontSize": 12}
  }
}
