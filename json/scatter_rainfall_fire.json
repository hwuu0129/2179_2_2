{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "title": {
    "text": "Rainfall vs Bushfire Detections by Australian State (2014–2024)",
    "subtitle": "Each point = one state in one year. Triangle = 2019 (Black Summer). Trend lines shown for states with strong correlation.",
    "fontSize": 14,
    "subtitleFontSize": 10,
    "fontWeight": "bold",
    "anchor": "start",
    "offset": 10
  },
  "data": {
    "url": "https://hwuu0129.github.io/2179_2_2/data/australia_fire_rainfall_scatter.csv"
  },
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "opacity": 0.85, "size": 80},
      "encoding": {
        "x": {
          "field": "rainfall_mm",
          "type": "quantitative",
          "axis": {"title": "Annual Rainfall (mm)", "format": "~s"}
        },
        "y": {
          "field": "fire_count",
          "type": "quantitative",
          "axis": {"title": "Fire Detections", "format": "~s"}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "VIC", "QLD", "WA", "SA", "NT"],
            "range": ["#1f77b4", "#9467bd", "#2ca02c", "#ff7f0e", "#8c564b", "#d62728"]
          },
          "legend": {"title": "State", "orient": "right"}
        },
        "shape": {
          "condition": {"test": "datum.year == '2019'", "value": "triangle-up"},
          "value": "circle"
        },
        "size": {
          "condition": {"test": "datum.year == '2019'", "value": 150},
          "value": 70
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "rainfall_mm", "type": "quantitative", "title": "Rainfall (mm)", "format": ".1f"},
          {"field": "fire_count", "type": "quantitative", "title": "Fire Detections", "format": ","},
          {"field": "avg_frp", "type": "quantitative", "title": "Avg Intensity (FRP)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.state == 'NSW'"}],
      "mark": {"type": "line", "color": "#1f77b4", "strokeDash": [4, 3], "strokeWidth": 1.5, "opacity": 0.5},
      "encoding": {
        "x": {"field": "rainfall_mm", "type": "quantitative"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "order": {"field": "rainfall_mm", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.state == 'SA'"}],
      "mark": {"type": "line", "color": "#8c564b", "strokeDash": [4, 3], "strokeWidth": 1.5, "opacity": 0.5},
      "encoding": {
        "x": {"field": "rainfall_mm", "type": "quantitative"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "order": {"field": "rainfall_mm", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.state == 'VIC'"}],
      "mark": {"type": "line", "color": "#9467bd", "strokeDash": [4, 3], "strokeWidth": 1.5, "opacity": 0.5},
      "encoding": {
        "x": {"field": "rainfall_mm", "type": "quantitative"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "order": {"field": "rainfall_mm", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.state == 'WA'"}],
      "mark": {"type": "line", "color": "#ff7f0e", "strokeDash": [4, 3], "strokeWidth": 1.5, "opacity": 0.5},
      "encoding": {
        "x": {"field": "rainfall_mm", "type": "quantitative"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "order": {"field": "rainfall_mm", "type": "quantitative"}
      }
    }
  ]
}
