{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bushfire Detections by State",
    "subtitle": "2024 (NASA VIIRS)"
  },
  "width": 700,
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 700
  },
  "data": {
    "url": "data/australia_states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/aus_states528.csv",
          "format": {"type": "csv"}
        },
        "key": "STATE_NAME",
        "fields": ["total_fire", "avg_frp", "grid_cells"]
      }
    },
    {
      "calculate": "toNumber(datum.total_fire)",
      "as": "total_fire_num"
    },
    {
      "calculate": "toNumber(datum.avg_frp)",
      "as": "avg_frp_num"
    },
    {
      "calculate": "toNumber(datum.grid_cells)",
      "as": "grid_cells_num"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "total_fire_num",
      "type": "quantitative",
      "scale": {
        "scheme": "orangered"
      },
      "title": "Fire Detections"
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "total_fire_num",
        "type": "quantitative",
        "title": "Fire Count"
      },
      {
        "field": "avg_frp_num",
        "type": "quantitative",
        "title": "Avg FRP (MW)",
        "format": ".1f"
      },
      {
        "field": "grid_cells_num",
        "type": "quantitative",
        "title": "Grid Cells"
      }
    ]
  }
}
