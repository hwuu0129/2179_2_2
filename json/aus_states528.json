{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bushfire Detections by State",
    "subtitle": "2024 (NASA VIIRS)"
  },
  "width": 700,
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 700
  },
  "data": {
    "url": "https://hwuu0129.github.io/2179_2_2/data/australia_states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "https://hwuu0129.github.io/2179_2_2/data/aus_states528.csv"
        },
        "key": "STATE_NAME",
        "fields": ["total_fire", "avg_frp", "grid_cells"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "total_fire",
      "type": "quantitative",
      "scale": {"scheme": "orangered"},
      "title": "Fire Detections"
    },
    "tooltip": [
      {"field": "properties.STATE_NAME", "type": "nominal",      "title": "State"},
      {"field": "total_fire",            "type": "quantitative", "title": "Fire Count", "format": ","},
      {"field": "avg_frp",               "type": "quantitative", "title": "Avg FRP"},
      {"field": "grid_cells",            "type": "quantitative", "title": "Grid Cells"}
    ]
  }
}
