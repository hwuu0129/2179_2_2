{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bushfire Detections by State",
    "subtitle": " 2024 (NASA VIIRS)"
  },
  "width": 700,
  "height": 400,
  "projection": {"type": "mercator"},
  "data": {
    "url": "data/Australian_states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {"url": "data/aus_states528.csv"},
        "key": "STATE_NAME",
        "fields": ["fire_count", "avg_frp"]
      }
    }
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
  "encoding": {
    "color": {
      "field": "fire_count",
      "type": "quantitative",
      "scale": {"scheme": "orangered"},
      "title": "Fire Detections"
    },
    "tooltip": [
      {"field": "properties.STATE_NAME", "type": "nominal", "title": "State"},
      {"field": "fire_count", "type": "quantitative", "title": "Fire Count"},
      {
        "field": "avg_frp",
        "type": "quantitative",
        "title": "Avg FRP (MW)",
        "format": ".1f"
      }
    ]
  }
}
