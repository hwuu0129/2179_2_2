{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Country-Year Fire Detection Heatmap (2014\u20132024)",
    "subtitle": "Top 10 countries by total active fire detections in NASA FIRMS gridded data",
    "anchor": "middle"
  },
  "width": 360,
  "height": 300,
  "data": {
    "url": "https://hwuu0129.github.io/2179_2_2/data/country_year_heatmap_2014_2024.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "title": "Country",
      "sort": "-x"
    },
    "color": {
      "field": "total_fire_count",
      "type": "quantitative",
      "title": "Fire detections",
      "scale": {
        "scheme": "orangered"
      },
      "legend": {
        "format": "~s",
        "orient": "bottom",
        "labelFontSize": 10,
        "titleFontSize": 10,
        "symbolSize": 60,
        "offset": 8,
        "columns": 4
      }
    },
    "tooltip": [
      {
        "field": "country",
        "title": "Country"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "total_fire_count",
        "title": "Fire detections",
        "format": ","
      },
      {
        "field": "avg_frp",
        "title": "Average FRP",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12
    },
    "legend": {
      "labelFontSize": 10,
      "titleFontSize": 10,
      "orient": "bottom",
      "symbolSize": 60,
      "offset": 8,
      "columns": 4
    }
  },
  "padding": 0
}
