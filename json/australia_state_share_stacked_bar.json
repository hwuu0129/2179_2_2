{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Share of Fire Detections by Australian State",
  "subtitle": "Percentage contribution of each state to annual fire detections, 2014–2024",
  "fontSize": 15,
  "subtitleFontSize": 11,
  "fontWeight": "bold",
  "anchor": "middle",
  "offset": 10
},
  "width": 420,
  "height": 320,
  "data": {
    "url": "https://hwuu0129.github.io/2179_2_2/data/australia_state_year_2014_2024.csv"
  },
  "mark": {"type": "bar", "width": {"band": 0.85}},
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {"labelAngle": 0, "labelFontSize": 11}
    },
    "y": {
      "aggregate": "sum",
      "field": "total_fire",
      "type": "quantitative",
      "title": "Share of fire detections (%)",
      "stack": "normalize",
      "axis": {"format": "%", "labelFontSize": 11, "titleFontSize": 12}
    },
    "color": {
      "field": "STATE_NAME",
      "type": "nominal",
      "title": "State",
      "scale": {
        "domain": [
          "Northern Territory",
          "Queensland",
          "Western Australia",
          "New South Wales",
          "Victoria",
          "South Australia",
          "Tasmania",
          "Australian Capital Territory"
        ],
        "range": [
          "#d62728",
          "#ff7f0e",
          "#2ca02c",
          "#1f77b4",
          "#9467bd",
          "#8c564b",
          "#e377c2",
          "#7f7f7f"
        ]
      },
      "legend": {
  "orient": "bottom",
  "labelFontSize": 9,
  "titleFontSize": 9,
  "symbolSize": 60,
  "columns": 4
}
    },
    "tooltip": [
      {"field": "STATE_NAME", "type": "nominal", "title": "State"},
      {"field": "year", "type": "ordinal", "title": "Year"},
      {
        "aggregate": "sum",
        "field": "total_fire",
        "type": "quantitative",
        "title": "Fire detections",
        "format": ","
      }
    ]
  }
}
