{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Australia Fire Detections Over Time (2014–2024)",
    "subtitle": "Total active fire detections aggregated from NASA FIRMS gridded data"
  },
  "width": 650,
  "height": 350,
  "data": {
    "url": "data/australia_yearly_fire_2014_2024.csv"
  },
  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Year",
      "axis": {
        "format": "d"
      }
    },
    "y": {
      "field": "total_fire_count",
      "type": "quantitative",
      "title": "Fire detections",
      "axis": {
        "format": "~s"
      }
    },
    "order": {
      "field": "year",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "total_fire_count",
        "title": "Fire detections",
        "format": ","
      },
      {
        "field": "avg_frp",
        "title": "Average FRP",
        "format": ".2f"
      },
      {
        "field": "grid_cells",
        "title": "Grid cells"
      }
    ]
  }
}
