{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Global Active Fire Detections by Country (2014–2024)",
    "subtitle": "Total fire detections aggregated from NASA FIRMS gridded data"
  },
  "width": 900,
  "height": 500,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/country_fire_2014_2024_for_map.csv"
            },
            "key": "id",
            "fields": ["country", "iso_a3", "total_fire_count", "avg_frp"]
          }
        },
        {
          "filter": "isValid(datum.total_fire_count)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "total_fire_count",
          "type": "quantitative",
          "title": "Fire detections",
          "scale": {
            "scheme": "orangered"
          },
          "legend": {
            "format": "~s"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "iso_a3",
            "title": "ISO code"
          },
          {
            "field": "total_fire_count",
            "title": "Fire detections",
            "format": ","
          },
          {
            "field": "avg_frp",
            "title": "Average FRP",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
