{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Bushfire Activity",
    "subtitle": "NASA VIIRS fire detections, 2026"
  },
  "width": 900,
  "height": 500,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/Global_fire.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.longitude)",
          "as": "longitude_num"
        },
        {
          "calculate": "toNumber(datum.latitude)",
          "as": "latitude_num"
        },
        {
          "calculate": "toNumber(datum.frp)",
          "as": "frp_num"
        },
        {
          "filter": "isValid(datum.longitude_num) && isValid(datum.latitude_num) && isValid(datum.frp_num)"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.45,
        "stroke": "white",
        "strokeWidth": 0.2
      },
      "encoding": {
        "longitude": {
          "field": "longitude_num",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude_num",
          "type": "quantitative"
        },
        "size": {
          "field": "frp_num",
          "type": "quantitative",
          "title": "Fire Radiative Power",
          "scale": {
            "range": [5, 400]
          }
        },
        "color": {
          "field": "frp_num",
          "type": "quantitative",
          "title": "FRP",
          "scale": {
            "scheme": "orangered"
          }
        },
        "tooltip": [
          {
            "field": "latitude",
            "type": "quantitative",
            "title": "Latitude"
          },
          {
            "field": "longitude",
            "type": "quantitative",
            "title": "Longitude"
          },
          {
            "field": "frp",
            "type": "quantitative",
            "title": "Fire Radiative Power"
          },
          {
            "field": "confidence",
            "type": "nominal",
            "title": "Confidence"
          },
          {
            "field": "acq_date",
            "type": "nominal",
            "title": "Date"
          },
          {
            "field": "daynight",
            "type": "nominal",
            "title": "Day / Night"
          }
        ]
      }
    }
  ]
}
