{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Active Fire Detections by Country",
    "subtitle": "NASA VIIRS fire detections, 6\u201315 May 2026",
    "anchor": "middle"
  },
  "width": 820,
  "height": 400,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "https://hwuu0129.github.io/2179_2_2/data/country_fire_2026_for_map.csv"
            },
            "key": "id",
            "fields": [
              "country",
              "iso_a3",
              "total_fire_count",
              "avg_frp"
            ]
          }
        },
        {
          "filter": "isValid(datum.total_fire_count)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "total_fire_count",
          "type": "quantitative",
          "title": "Fire detections",
          "scale": {
            "scheme": "orangered"
          },
          "legend": {
            "format": "~s",
            "orient": "bottom",
            "labelFontSize": 10,
            "titleFontSize": 10,
            "symbolSize": 60,
            "offset": 8,
            "columns": 4
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "iso_a3",
            "type": "nominal",
            "title": "ISO code"
          },
          {
            "field": "total_fire_count",
            "type": "quantitative",
            "title": "Fire detections",
            "format": ","
          },
          {
            "field": "avg_frp",
            "type": "quantitative",
            "title": "Average FRP",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "fontSize": 16,
      "subtitleFontSize": 12
    },
    "legend": {
      "labelFontSize": 10,
      "titleFontSize": 10,
      "orient": "bottom",
      "symbolSize": 60,
      "offset": 8,
      "columns": 4
    }
  },
  "padding": 0
}
