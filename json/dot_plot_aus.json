{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Fire Intensity Across Australia",
  "width": 800,
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 750
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/australia_2024.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.65
      },
      "encoding": {
        "longitude": {
          "field": "lon_bin",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_bin",
          "type": "quantitative"
        },
        "size": {
          "field": "fire_count",
          "type": "quantitative",
          "title": "Fire Count",
          "scale": {
            "range": [20, 1200]
          }
        },
        "color": {
          "field": "avg_frp",
          "type": "quantitative",
          "title": "Average Fire Intensity",
          "scale": {
            "scheme": "reds"
          }
        },
        "tooltip": [
          {
            "field": "lat_bin",
            "type": "quantitative",
            "title": "Latitude"
          },
          {
            "field": "lon_bin",
            "type": "quantitative",
            "title": "Longitude"
          },
          {
            "field": "fire_count",
            "type": "quantitative",
            "title": "Fire Count"
          },
          {
            "field": "avg_frp",
            "type": "quantitative",
            "title": "Average FRP"
          }
        ]
      }
    }
  ]
}
