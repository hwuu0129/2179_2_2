{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Fire Intensity Across Australia",
    "subtitle": "Bubble size shows fire detections; colour shows average FRP, 2024"
  },
  "width": 800,
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 700
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "geojson"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/australia_2024.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.65,
        "stroke": "white",
        "strokeWidth": 0.4
      },
      "encoding": {
        "longitude": {
          "field": "lon_bin",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_bin",
          "type": "quantitative"
        },
        "size": {
          "field": "fire_count",
          "type": "quantitative",
          "title": "Fire Detections",
          "scale": {
            "range": [10, 1200]
          }
        },
        "color": {
          "field": "avg_frp",
          "type": "quantitative",
          "title": "Average FRP",
          "scale": {
            "scheme": "reds"
          }
        },
        "tooltip": [
          {
            "field": "lat_bin",
            "type": "quantitative",
            "title": "Latitude"
          },
          {
            "field": "lon_bin",
            "type": "quantitative",
            "title": "Longitude"
          },
          {
            "field": "fire_count",
            "type": "quantitative",
            "title": "Fire detections"
          },
          {
            "field": "avg_frp",
            "type": "quantitative",
            "title": "Average FRP"
          }
        ]
      }
    }
  ]
}
