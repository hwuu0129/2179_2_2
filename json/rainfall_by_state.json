{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Annual Rainfall by Australian State/Territory (2014\u20132024)",
    "subtitle": "Area-averaged rainfall (mm) \u2014 Source: Bureau of Meteorology",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "fontWeight": "bold",
    "anchor": "start",
    "offset": 10
  },
  "data": {
    "url": "data/australia_state_rainfall_2014_2024.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 55
        },
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "labelAngle": 0,
            "title": "Year"
          }
        },
        "y": {
          "field": "rainfall_mm",
          "type": "quantitative",
          "axis": {
            "title": "Rainfall (mm)",
            "format": "~s"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "NSW",
              "VIC",
              "QLD",
              "WA",
              "SA",
              "NT"
            ],
            "range": [
              "#1f77b4",
              "#9467bd",
              "#2ca02c",
              "#ff7f0e",
              "#8c564b",
              "#d62728"
            ]
          },
          "legend": {
            "title": "State / Territory",
            "orient": "right"
          }
        },
        "opacity": {
          "condition": {
            "param": "hover_state",
            "value": 1
          },
          "value": 0.15
        },
        "strokeWidth": {
          "condition": {
            "param": "hover_state",
            "value": 3
          },
          "value": 2
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "rainfall_mm",
            "type": "quantitative",
            "title": "Rainfall (mm)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#e63946",
        "strokeDash": [
          6,
          3
        ],
        "strokeWidth": 1.5,
        "opacity": 0.7
      },
      "transform": [
        {
          "filter": "datum.year == '2019'"
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -8,
        "fontSize": 10,
        "fontStyle": "italic",
        "color": "#e63946",
        "text": "Black Summer drought"
      },
      "transform": [
        {
          "filter": "datum.year == '2019' && datum.state == 'NSW'"
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rainfall_mm",
          "type": "quantitative"
        }
      }
    }
  ],
  "params": [
    {
      "name": "hover_state",
      "select": {
        "type": "point",
        "fields": [
          "state"
        ],
        "on": "mouseover"
      },
      "bind": "legend"
    }
  ]
}
